{
  "name": "void-kit",
  "version": "0.1.0",
  "description": "Conventions and types that keep Void server routes in one shape, whoever writes them (including AI).",
  "license": "MIT",
  "author": "ashunar0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./lint": "./lint/index.mjs",
    "./client": "./src/client.ts"
  },
  "files": [
    "dist",
    "lint",
    "docs",
    "bin"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts test/*.test.mjs",
    "build": "node scripts/build.mjs",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "hono": "^4.13.0",
    "void": ">=1.11.0"
  },
  "devDependencies": {
    "hono": "^4.13.14",
    "typescript": "^5.9.3",
    "void": "^1.11.0",
    "zod": "^4.1.12"
  },
  "bin": {
    "void-kit": "./bin/void-kit.mjs"
  },
  "dependencies": {
    "oxlint": "^1.80.0"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./lint": "./lint/index.mjs",
      "./package.json": "./package.json",
      "./client": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      }
    }
  }
}
